{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "FRANKYCPP_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "debug",
      "displayName": "Win Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Win Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Win RelWithDebInfo",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "wsl-base",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "${sourceDir}/cmake-build-wsl-${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "environment": {
        "VCPKG_ROOT": "/home/frank/vcpkg"
      }
    },
    {
      "name": "wsl-debug",
      "displayName": "WSL Debug",
      "inherits": "wsl-base",
      "binaryDir": "${sourceDir}/cmake-build-wsl-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wsl-release",
      "displayName": "WSL Release",
      "inherits": "wsl-base",
      "binaryDir": "${sourceDir}/cmake-build-wsl-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wsl-relwithdebinfo",
      "displayName": "WSL RelWithDebInfo",
      "inherits": "wsl-base",
      "binaryDir": "${sourceDir}/cmake-build-wsl-relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "wsl-clang-base",
      "hidden": true,
      "inherits": "wsl-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18"
      }
    },
    {
      "name": "wsl-clang-debug",
      "displayName": "WSL Clang Debug",
      "inherits": "wsl-clang-base",
      "binaryDir": "${sourceDir}/cmake-build-wsl-clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wsl-clang-release",
      "displayName": "WSL Clang Release",
      "inherits": "wsl-clang-base",
      "binaryDir": "${sourceDir}/cmake-build-wsl-clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI Windows",
      "inherits": "release",
      "cacheVariables": {
        "STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "ci-linux",
      "displayName": "CI Linux",
      "inherits": "wsl-release",
      "cacheVariables": {
        "STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "win-release-production",
      "displayName": "Win Release (PROD)",
      "inherits": "release",
      "cacheVariables": {
        "FRANKYCPP_PRODUCTION": "ON"
      }
    },
    {
      "name": "wsl-release-production",
      "displayName": "WSL Release Production",
      "inherits": "wsl-release",
      "binaryDir": "${sourceDir}/cmake-build-wsl-release-production",
      "cacheVariables": {
        "FRANKYCPP_PRODUCTION": "ON"
      }
    },
    {
      "name": "win-debug-asan",
      "displayName": "Win Debug ASAN",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/cmake-build-win-debug-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "win-relwithdebinfo-asan",
      "displayName": "Win RelWithDebInfo ASAN",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/cmake-build-win-relwithdebinfo-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "wsl-debug-tsan",
      "displayName": "WSL Debug TSAN",
      "inherits": "wsl-base",
      "binaryDir": "${sourceDir}/cmake-build-wsl-debug-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "wsl-relwithdebinfo-tsan",
      "displayName": "WSL RelWithDebInfo TSAN",
      "inherits": "wsl-base",
      "binaryDir": "${sourceDir}/cmake-build-wsl-relwithdebinfo-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "wsl-debug-asan",
      "displayName": "WSL Debug ASAN",
      "inherits": "wsl-base",
      "binaryDir": "${sourceDir}/cmake-build-wsl-debug-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "wsl-clang-debug-tsan",
      "displayName": "WSL Clang Debug TSAN",
      "inherits": "wsl-clang-base",
      "binaryDir": "${sourceDir}/cmake-build-wsl-clang-debug-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Win Debug",
      "configurePreset": "debug",
      "jobs": 30
    },
    {
      "name": "release",
      "displayName": "Win Release",
      "configurePreset": "release",
      "jobs": 30
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Win RelWithDebInfo",
      "configurePreset": "relwithdebinfo",
      "jobs": 30
    },
    {
      "name": "wsl-debug",
      "displayName": "WSL Debug",
      "configurePreset": "wsl-debug",
      "jobs": 30
    },
    {
      "name": "wsl-release",
      "displayName": "WSL Release",
      "configurePreset": "wsl-release",
      "jobs": 30
    },
    {
      "name": "wsl-relwithdebinfo",
      "displayName": "WSL RelWithDebInfo",
      "configurePreset": "wsl-relwithdebinfo",
      "jobs": 30
    },
    {
      "name": "wsl-clang-debug",
      "displayName": "WSL Clang Debug",
      "configurePreset": "wsl-clang-debug",
      "jobs": 30
    },
    {
      "name": "wsl-clang-release",
      "displayName": "WSL Clang Release",
      "configurePreset": "wsl-clang-release",
      "jobs": 30
    },
    {
      "name": "ci-windows",
      "displayName": "CI Windows",
      "configurePreset": "ci-windows",
      "jobs": 30
    },
    {
      "name": "ci-linux",
      "displayName": "CI Linux",
      "configurePreset": "ci-linux",
      "jobs": 30
    },
    {
      "name": "win-release-production",
      "displayName": "Win Release (PROD)",
      "configurePreset": "win-release-production",
      "jobs": 30
    },
    {
      "name": "wsl-release-production",
      "displayName": "WSL Release Production",
      "configurePreset": "wsl-release-production",
      "jobs": 30
    },
    {
      "name": "win-debug-asan",
      "displayName": "Win Debug ASAN",
      "configurePreset": "win-debug-asan",
      "jobs": 30
    },
    {
      "name": "win-relwithdebinfo-asan",
      "displayName": "Win RelWithDebInfo ASAN",
      "configurePreset": "win-relwithdebinfo-asan",
      "jobs": 30
    },
    {
      "name": "wsl-debug-tsan",
      "displayName": "WSL Debug TSAN",
      "configurePreset": "wsl-debug-tsan",
      "jobs": 30
    },
    {
      "name": "wsl-relwithdebinfo-tsan",
      "displayName": "WSL RelWithDebInfo TSAN",
      "configurePreset": "wsl-relwithdebinfo-tsan",
      "jobs": 30
    },
    {
      "name": "wsl-debug-asan",
      "displayName": "WSL Debug ASAN",
      "configurePreset": "wsl-debug-asan",
      "jobs": 30
    },
    {
      "name": "wsl-clang-debug-tsan",
      "displayName": "WSL Clang Debug TSAN",
      "configurePreset": "wsl-clang-debug-tsan",
      "jobs": 30
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Win Debug Tests",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "displayName": "Win Release Tests",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wsl-debug",
      "displayName": "WSL Debug Tests",
      "configurePreset": "wsl-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wsl-release",
      "displayName": "WSL Release Tests",
      "configurePreset": "wsl-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wsl-clang-debug",
      "displayName": "WSL Clang Debug Tests",
      "configurePreset": "wsl-clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wsl-clang-release",
      "displayName": "WSL Clang Release Tests",
      "configurePreset": "wsl-clang-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-debug-asan",
      "displayName": "Win Debug ASAN Tests",
      "configurePreset": "win-debug-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wsl-debug-tsan",
      "displayName": "WSL Debug TSAN Tests",
      "configurePreset": "wsl-debug-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wsl-debug-asan",
      "displayName": "WSL Debug ASAN Tests",
      "configurePreset": "wsl-debug-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wsl-clang-debug-tsan",
      "displayName": "WSL Clang Debug TSAN Tests",
      "configurePreset": "wsl-clang-debug-tsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
